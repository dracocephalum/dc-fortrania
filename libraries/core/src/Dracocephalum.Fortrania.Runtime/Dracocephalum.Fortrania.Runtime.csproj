<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The runtime library that C# translated from FORTRAN 77 by Fortrania calls: character values, formatted and unformatted input and output, and what a program takes from its compiler.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every file states its own usings, so that it compiles in a project that is not this one. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
