<Project>

  <!--
    Dracocephalum.Fortrania.Build: the project translates its FORTRAN 77 to
    C# as it builds, and compiles the translation.

    What a project may set:

      Fortrania           items, the project's settings files, all of them
                          one translation named for the project's assembly;
                          every fortrania.json and *.fortrania.json in its
                          folder unless EnableDefaultFortraniaItems is false.
                          The package's props have them
      FortraniaTranslate  never, ifChanged or always, for this build. never
                          translates nothing and compiles what is there, the
                          summary beside the project file embedded as it is;
                          always writes every file again; empty or
                          ifChanged, when something it was made from changed
      FortraniaFetch      never, once or always: when the sources the settings
                          say where to download from are downloaded, as the
                          translation runs. once, the default, where they are
                          not on the machine; never reaches no server, and
                          compiles a project whose sources are not there as
                          it was translated last; always replaces what an
                          earlier fetch made, on each run of the translation
      FortraniaPlugin     items, assemblies whose plugins take part in the
                          translation, in order. A project of plugins is
                          referenced so that it is built first and its
                          assembly becomes one, and is not referenced by
                          the compilation:
                            ProjectReference with ReferenceOutputAssembly
                            false and OutputItemType FortraniaPlugin
                          A plugin built again translates again

    The translation is the command's, run as a program of its own with what
    the build resolved: the assemblies of the project's project and package
    references, the framework's left out, from which the translator reads
    the summaries of the projects it calls into. It is run when something it
    read last time changed, or a file came to match or ceased to match the
    patterns of its sources, or the command line changed, or a file it made
    is gone; the inventory it writes in the intermediate folder,
    fortrania.inventory, says which.
    The settings may name $(IntermediateOutput), that folder, for a
    translation that goes with dotnet clean; one written elsewhere, in the
    project's folder to be committed say, is never removed by a clean.

    The project's summary, <assembly>.fortrania-summary.json, is written
    beside the project file, to be committed with it, and is embedded in
    the assembly as Fortrania.Summary.json for a project that references
    this one. What the translation is made of and lies outside the
    project's folder is added to the compilation, as is what lies inside it
    and was written for the first time, which the SDK did not see when it
    listed the folder.

    TranslateFortran is the target to run a step of the project's own
    after, before the compiler, whether it translated or found nothing to
    do: a target with AfterTargets="TranslateFortran". The targets whose
    names start with an underscore are this package's, and may change.
    What changes the translated files is a plugin's, not such a step's.

    (No double hyphen appears in a comment here: XML forbids it.)
  -->

  <PropertyGroup>
    <FortraniaFetch Condition="'$(FortraniaFetch)' == ''">once</FortraniaFetch>
  </PropertyGroup>

  <!-- A settings file is the translation's, and not a file to copy anywhere. -->
  <ItemGroup>
    <None Remove="@(Fortrania)" />
  </ItemGroup>

  <!--
    Before the resources are named, so that the summary is embedded as the
    others are: a target named in BeforeTargets runs only after what the
    target it comes before depends on.
  -->
  <PropertyGroup>
    <PrepareResourcesDependsOn>TranslateFortran;$(PrepareResourcesDependsOn)</PrepareResourcesDependsOn>
  </PropertyGroup>

  <Target Name="TranslateFortran"
          DependsOnTargets="ResolveReferences;_FortraniaPrepare;_FortraniaCheck;_FortraniaTranslate;_FortraniaAddTranslation" />

  <Target Name="_FortraniaPrepare">
    <Error Condition="'@(Fortrania)' == '' and '$(FortraniaTranslate)' != 'never'"
           Text="The project has no settings to translate: no fortrania.json or *.fortrania.json in its folder, and no Fortrania item." />
    <Error Condition="'$(FortraniaTranslate)' != '' and '$(FortraniaTranslate)' != 'never' and '$(FortraniaTranslate)' != 'ifChanged' and '$(FortraniaTranslate)' != 'always'"
           Text="FortraniaTranslate is '$(FortraniaTranslate)'; it is never, ifChanged or always, or empty." />
    <Error Condition="'$(FortraniaFetch)' != 'never' and '$(FortraniaFetch)' != 'once' and '$(FortraniaFetch)' != 'always'"
           Text="FortraniaFetch is '$(FortraniaFetch)'; it is never, once or always." />

    <PropertyGroup>
      <_FortraniaSummaryFile>$(MSBuildProjectDirectory)/$(AssemblyName).fortrania-summary.json</_FortraniaSummaryFile>
      <_FortraniaIntermediate>$([System.IO.Path]::GetDirectoryName('$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))'))</_FortraniaIntermediate>
      <_FortraniaInventory>$(_FortraniaIntermediate)/fortrania.inventory</_FortraniaInventory>
      <_FortraniaCommandLineFile>$(_FortraniaIntermediate)/fortrania.command</_FortraniaCommandLineFile>
      <_FortraniaCommand>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tools', 'net10.0', 'Dracocephalum.Fortrania.Cli.dll'))</_FortraniaCommand>
      <_FortraniaDotnet>$(DOTNET_HOST_PATH)</_FortraniaDotnet>
      <_FortraniaDotnet Condition="'$(_FortraniaDotnet)' == ''">dotnet</_FortraniaDotnet>
    </PropertyGroup>
    <Error Condition="'$(FortraniaTranslate)' == 'never' and !Exists('$(_FortraniaSummaryFile)')"
           Text="FortraniaTranslate is never, and there is no summary at $(_FortraniaSummaryFile) to embed; translate the project once and keep its summary with it." />

    <ItemGroup>
      <_FortraniaReference Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' == ''" />
    </ItemGroup>

    <!--
      What tells that a reference changed for the translation: of a project,
      the copy of its summary beside its assembly, which changes only when
      the summary does, so that a library compiled again for any other
      reason translates nothing that calls into it; of a package, the
      assembly, which changes with the package's version.
    -->
    <ItemGroup>
      <_FortraniaReferenceInput Include="@(_FortraniaReference->'%(RootDir)%(Directory)%(Filename).fortrania-summary.json')"
                                Condition="'%(_FortraniaReference.ReferenceSourceTarget)' == 'ProjectReference'" />
      <_FortraniaReferenceInput Remove="@(_FortraniaReferenceInput)" Condition="!Exists('%(FullPath)')" />
      <_FortraniaReferenceInput Include="@(_FortraniaReference)"
                                Condition="'%(_FortraniaReference.ReferenceSourceTarget)' != 'ProjectReference'" />
    </ItemGroup>

    <PropertyGroup>
      <_FortraniaArguments>--name "$(AssemblyName)" @(Fortrania->'"%(FullPath)"', ' ') --summary "$(_FortraniaSummaryFile)"</_FortraniaArguments>
      <_FortraniaTranslateArguments>translate csharp $(_FortraniaArguments) --inventory "$(_FortraniaInventory)"</_FortraniaTranslateArguments>
      <_FortraniaTranslateArguments Condition="'@(_FortraniaReference)' != ''">$(_FortraniaTranslateArguments) @(_FortraniaReference->'--reference "%(FullPath)"', ' ')</_FortraniaTranslateArguments>
      <_FortraniaTranslateArguments Condition="'@(FortraniaPlugin)' != ''">$(_FortraniaTranslateArguments) @(FortraniaPlugin->'--plugin "%(FullPath)"', ' ')</_FortraniaTranslateArguments>
    </PropertyGroup>

    <!-- Its time changes when the command line does: a new version of the command, other settings or other references. -->
    <WriteLinesToFile File="$(_FortraniaCommandLineFile)"
                      Lines="$(_FortraniaCommand) $(_FortraniaTranslateArguments)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Condition="'$(FortraniaTranslate)' != 'never'" />

    <!--
      After the command line is written, so that a build told always is not
      followed by one that translates again, and a build fetching otherwise
      translates nothing again for that: how the sources come is not what
      they are translated to.
    -->
    <PropertyGroup>
      <_FortraniaTranslateArguments Condition="'$(FortraniaTranslate)' == 'always'">$(_FortraniaTranslateArguments) --force</_FortraniaTranslateArguments>
      <_FortraniaTranslateArguments>$(_FortraniaTranslateArguments) --fetch $(FortraniaFetch)</_FortraniaTranslateArguments>
    </PropertyGroup>

    <ItemGroup>
      <FileWrites Include="$(_FortraniaInventory);$(_FortraniaCommandLineFile)" />
    </ItemGroup>
  </Target>

  <!--
    What the inventory's times cannot show: a file come to match a pattern
    of the sources, or one read or made that is gone. Either removes the
    inventory, so that the translation runs; so does always.
  -->
  <Target Name="_FortraniaCheck" Condition="'$(DesignTimeBuild)' != 'true' and '$(FortraniaTranslate)' != 'never'">
    <ReadLinesFromFile File="$(_FortraniaInventory)" Condition="Exists('$(_FortraniaInventory)')">
      <Output TaskParameter="Lines" ItemName="_FortraniaInventoryLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_FortraniaRead Include="$([System.String]::Copy('%(_FortraniaInventoryLine.Identity)').Substring(5))"
                      Condition="$([System.String]::Copy('%(_FortraniaInventoryLine.Identity)').StartsWith('read '))" />
      <_FortraniaPattern Include="$([System.String]::Copy('%(_FortraniaInventoryLine.Identity)').Substring(8))"
                         Condition="$([System.String]::Copy('%(_FortraniaInventoryLine.Identity)').StartsWith('pattern '))" />
      <_FortraniaMade Include="$([System.String]::Copy('%(_FortraniaInventoryLine.Identity)').Substring(5))"
                      Condition="$([System.String]::Copy('%(_FortraniaInventoryLine.Identity)').StartsWith('file '))" />
      <!-- A reference read is told by what stands for it in _FortraniaReferenceInput. -->
      <_FortraniaRead Remove="@(_FortraniaReference->'%(FullPath)')" />
    </ItemGroup>
    <PropertyGroup>
      <_FortraniaPatterns>@(_FortraniaPattern)</_FortraniaPatterns>
      <!-- An item escapes its wildcards; a pattern is to match again. -->
      <_FortraniaPatterns>$([MSBuild]::Unescape($(_FortraniaPatterns)))</_FortraniaPatterns>
    </PropertyGroup>
    <ItemGroup>
      <_FortraniaMatched Include="$(_FortraniaPatterns)" />
      <_FortraniaAdded Include="@(_FortraniaMatched)" Exclude="@(_FortraniaRead)" />
      <_FortraniaGone Include="@(_FortraniaRead);@(_FortraniaMade)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Delete Files="$(_FortraniaInventory)"
            Condition="'@(_FortraniaAdded)' != '' or '@(_FortraniaGone)' != '' or '$(FortraniaTranslate)' == 'always'" />
  </Target>

  <Target Name="_FortraniaTranslate"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(FortraniaTranslate)' != 'never'"
          Inputs="@(Fortrania);$(_FortraniaCommandLineFile);@(_FortraniaRead);@(_FortraniaReferenceInput)"
          Outputs="$(_FortraniaInventory)">
    <Exec Command="&quot;$(_FortraniaDotnet)&quot; &quot;$(_FortraniaCommand)&quot; $(_FortraniaTranslateArguments)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="IntermediateOutput=$(_FortraniaIntermediate)"
          StandardOutputImportance="normal" />
  </Target>

  <!--
    What the translation is made of, from the inventory the run wrote or
    left, and the summary beside the project file. Told never, on a fresh
    checkout there is no inventory, and what is compiled is what the
    project's folder holds, which the SDK finds by itself.

    The translation's sources are compiled in the inventory's order, those
    the SDK found taken out first: a file the run wrote for the first time
    was not there when the SDK listed the folder, and the next build finds
    it there, in another place of the list. The SDK compiles again whenever
    the list changes, order and all, so a build after a translation would
    compile once more for nothing.
  -->
  <Target Name="_FortraniaAddTranslation">
    <ReadLinesFromFile File="$(_FortraniaInventory)" Condition="Exists('$(_FortraniaInventory)')">
      <Output TaskParameter="Lines" ItemName="_FortraniaInventoryAfter" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_FortraniaFile Include="$([System.String]::Copy('%(_FortraniaInventoryAfter.Identity)').Substring(5))"
                      Condition="$([System.String]::Copy('%(_FortraniaInventoryAfter.Identity)').StartsWith('file '))" />
      <_FortraniaCompile Include="@(_FortraniaFile)" Condition="'%(Extension)' == '.cs'" />
      <Compile Remove="@(_FortraniaCompile)" MatchOnMetadata="FullPath" />
      <Compile Include="@(_FortraniaCompile)" />
      <FileWrites Include="@(_FortraniaFile)"
                  Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_FortraniaIntermediate)'))" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(_FortraniaSummaryFile)')">
      <EmbeddedResource Include="$(_FortraniaSummaryFile)"
                        LogicalName="Fortrania.Summary.json"
                        WithCulture="false"
                        Type="Non-Resx" />
    </ItemGroup>

    <!-- The copy a project that references this one watches; see _FortraniaPrepare. -->
    <Copy SourceFiles="$(_FortraniaSummaryFile)"
          DestinationFiles="$(TargetDir)$(TargetName).fortrania-summary.json"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_FortraniaSummaryFile)')" />
    <ItemGroup Condition="Exists('$(_FortraniaSummaryFile)')">
      <FileWrites Include="$(TargetDir)$(TargetName).fortrania-summary.json" />
    </ItemGroup>
  </Target>

</Project>
