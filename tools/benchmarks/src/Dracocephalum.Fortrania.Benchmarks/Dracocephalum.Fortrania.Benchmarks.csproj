<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every method is compiled once, with full optimization, when it is
         first called. Left to the runtime, a method starts out unoptimized
         and is compiled again in the background a while later, which in a
         run this short falls in the middle of a measurement. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- What is measured is the runtime as it is in the tree, so that a change
         is measured before it is merged: agentics/rules/layout.md, "A component
         that is never released may reference another by path". -->
    <ProjectReference Include="../../../../libraries/core/src/Dracocephalum.Fortrania.Runtime/Dracocephalum.Fortrania.Runtime.csproj" />
  </ItemGroup>

</Project>
